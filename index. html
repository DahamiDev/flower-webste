<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Enchanted Garden - 3D Flower Paradise</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Cormorant+Garamond:wght@300;400;500;600&display=swap');
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Cormorant Garamond', serif;
            background: #000000;
            color: #ffffff;
            overflow-x: hidden;
            cursor: none;
        }
        
        /* Custom Cursor */
        .cursor {
            width: 20px;
            height: 20px;
            border: 2px solid rgba(255, 182, 193, 0.8);
            border-radius: 50%;
            position: fixed;
            pointer-events: none;
            z-index: 10000;
            transition: all 0.1s ease;
            mix-blend-mode: difference;
        }
        
        .cursor-follower {
            width: 40px;
            height: 40px;
            border: 1px solid rgba(255, 105, 180, 0.5);
            border-radius: 50%;
            position: fixed;
            pointer-events: none;
            z-index: 9999;
            transition: all 0.3s ease;
        }
        
        /* Parallax Container */
        .parallax-container {
            position: relative;
            width: 100%;
            min-height: 100vh;
        }
        
        /* Navigation */
        nav {
            position: fixed;
            top: 0;
            width: 100%;
            padding: 30px 60px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 1000;
            background: linear-gradient(180deg, rgba(0,0,0,0.8) 0%, transparent 100%);
        }
        
        .logo {
            font-family: 'Cinzel', serif;
            font-size: 32px;
            font-weight: 700;
            background: linear-gradient(135deg, #FFB6C1, #FF69B4, #DDA0DD);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-shadow: 0 0 30px rgba(255, 105, 180, 0.5);
        }
        
        .nav-links {
            display: flex;
            gap: 40px;
            list-style: none;
        }
        
        .nav-links a {
            color: rgba(255, 255, 255, 0.8);
            text-decoration: none;
            font-size: 18px;
            font-weight: 500;
            transition: all 0.3s;
            position: relative;
        }
        
        .nav-links a::after {
            content: '';
            position: absolute;
            bottom: -5px;
            left: 0;
            width: 0;
            height: 2px;
            background: linear-gradient(90deg, #FFB6C1, #FF69B4);
            transition: width 0.3s;
        }
        
        .nav-links a:hover {
            color: #FFB6C1;
        }
        
        .nav-links a:hover::after {
            width: 100%;
        }
        
        /* Hero Section */
        .hero {
            height: 100vh;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }
        
        .hero-content {
            text-align: center;
            z-index: 10;
            animation: fadeInUp 1.5s ease;
        }
        
        .hero-title {
            font-family: 'Cinzel', serif;
            font-size: 90px;
            font-weight: 700;
            margin-bottom: 20px;
            background: linear-gradient(135deg, #FFB6C1, #FF69B4, #DDA0DD, #98D8C8);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-shadow: 0 0 40px rgba(255, 105, 180, 0.3);
            letter-spacing: 3px;
        }
        
        .hero-subtitle {
            font-size: 28px;
            color: rgba(255, 255, 255, 0.8);
            margin-bottom: 40px;
            font-weight: 300;
            letter-spacing: 2px;
        }
        
        .cta-button {
            padding: 18px 50px;
            background: linear-gradient(135deg, #FF69B4, #FFB6C1);
            border: none;
            color: #000;
            font-size: 18px;
            font-weight: 600;
            border-radius: 50px;
            cursor: none;
            transition: all 0.4s;
            box-shadow: 0 10px 40px rgba(255, 105, 180, 0.4);
            font-family: 'Cinzel', serif;
            letter-spacing: 1px;
        }
        
        .cta-button:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 60px rgba(255, 105, 180, 0.6);
        }
        
        /* Floating Flowers */
        .flower {
            position: absolute;
            width: 150px;
            height: 150px;
            background-size: contain;
            background-repeat: no-repeat;
            animation: float 20s infinite ease-in-out;
            opacity: 0.7;
            filter: drop-shadow(0 0 20px rgba(255, 105, 180, 0.5));
        }
        
        .flower1 {
            top: 10%;
            left: 10%;
            animation-delay: 0s;
            animation-duration: 25s;
        }
        
        .flower2 {
            top: 20%;
            right: 15%;
            animation-delay: 2s;
            animation-duration: 30s;
        }
        
        .flower3 {
            bottom: 15%;
            left: 20%;
            animation-delay: 4s;
            animation-duration: 28s;
        }
        
        .flower4 {
            bottom: 25%;
            right: 10%;
            animation-delay: 6s;
            animation-duration: 26s;
        }
        
        /* Butterflies */
        .butterfly {
            position: absolute;
            width: 80px;
            height: 80px;
            background-size: contain;
            background-repeat: no-repeat;
            animation: butterfly-flight 15s infinite ease-in-out;
            opacity: 0.8;
            filter: drop-shadow(0 0 15px rgba(255, 182, 193, 0.6));
        }
        
        .butterfly1 {
            top: 30%;
            left: 5%;
            animation-delay: 0s;
        }
        
        .butterfly2 {
            top: 50%;
            right: 10%;
            animation-delay: 3s;
        }
        
        .butterfly3 {
            bottom: 30%;
            left: 30%;
            animation-delay: 6s;
        }
        
        /* Birds */
        .bird {
            position: absolute;
            width: 60px;
            height: 60px;
            background-size: contain;
            background-repeat: no-repeat;
            animation: bird-flight 20s infinite linear;
            opacity: 0.6;
        }
        
        .bird1 {
            top: 15%;
            animation-delay: 0s;
        }
        
        .bird2 {
            top: 40%;
            animation-delay: 5s;
        }
        
        /* Particle Effect */
        .particles {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            z-index: 1;
        }
        
        .particle {
            position: absolute;
            background: radial-gradient(circle, rgba(255, 182, 193, 0.8), transparent);
            border-radius: 50%;
            animation: particle-float 15s infinite ease-in-out;
        }
        
        /* Gallery Section */
        .gallery-section {
            min-height: 100vh;
            padding: 100px 60px;
            position: relative;
            z-index: 10;
        }
        
        .section-title {
            text-align: center;
            font-family: 'Cinzel', serif;
            font-size: 60px;
            font-weight: 700;
            margin-bottom: 80px;
            background: linear-gradient(135deg, #FFB6C1, #FF69B4, #DDA0DD);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        
        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 40px;
            max-width: 1400px;
            margin: 0 auto;
        }
        
        .gallery-item {
            position: relative;
            height: 400px;
            border-radius: 20px;
            overflow: hidden;
            cursor: none;
            transform-style: preserve-3d;
            transition: all 0.5s;
        }
        
        .gallery-item:hover {
            transform: scale(1.05) rotateY(10deg);
        }
        
        .gallery-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s;
        }
        
        .gallery-item:hover img {
            transform: scale(1.2);
        }
        
        .gallery-overlay {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            padding: 30px;
            background: linear-gradient(0deg, rgba(0,0,0,0.9) 0%, transparent 100%);
            transform: translateY(100%);
            transition: transform 0.5s;
        }
        
        .gallery-item:hover .gallery-overlay {
            transform: translateY(0);
        }
        
        .gallery-title {
            font-family: 'Cinzel', serif;
            font-size: 24px;
            color: #FFB6C1;
            margin-bottom: 10px;
        }
        
        .gallery-description {
            font-size: 16px;
            color: rgba(255, 255, 255, 0.8);
        }
        
        /* 3D Flower Cards */
        .cards-section {
            min-height: 100vh;
            padding: 100px 60px;
            position: relative;
        }
        
        .cards-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 50px;
            max-width: 1400px;
            margin: 0 auto;
            perspective: 1000px;
        }
        
        .flower-card {
            background: linear-gradient(135deg, rgba(255, 182, 193, 0.1), rgba(221, 160, 221, 0.1));
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 182, 193, 0.2);
            border-radius: 25px;
            padding: 40px;
            text-align: center;
            transition: all 0.5s;
            transform-style: preserve-3d;
        }
        
        .flower-card:hover {
            transform: translateY(-20px) rotateX(5deg);
            box-shadow: 0 30px 60px rgba(255, 105, 180, 0.3);
        }
        
        .flower-card-image {
            width: 200px;
            height: 200px;
            margin: 0 auto 30px;
            border-radius: 50%;
            overflow: hidden;
            border: 3px solid rgba(255, 182, 193, 0.3);
            box-shadow: 0 10px 40px rgba(255, 105, 180, 0.3);
        }
        
        .flower-card-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s;
        }
        
        .flower-card:hover .flower-card-image img {
            transform: scale(1.1) rotate(5deg);
        }
        
        .flower-card h3 {
            font-family: 'Cinzel', serif;
            font-size: 28px;
            color: #FFB6C1;
            margin-bottom: 15px;
        }
        
        .flower-card p {
            font-size: 18px;
            color: rgba(255, 255, 255, 0.7);
            line-height: 1.6;
        }
        
        /* Footer */
        footer {
            padding: 60px;
            text-align: center;
            background: linear-gradient(180deg, transparent, rgba(0,0,0,0.8));
            border-top: 1px solid rgba(255, 182, 193, 0.2);
        }
        
        footer p {
            font-size: 16px;
            color: rgba(255, 255, 255, 0.6);
            letter-spacing: 1px;
        }
        
        /* Animations */
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(50px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        @keyframes float {
            0%, 100% {
                transform: translateY(0) rotate(0deg);
            }
            25% {
                transform: translateY(-40px) rotate(5deg);
            }
            50% {
                transform: translateY(-20px) rotate(-5deg);
            }
            75% {
                transform: translateY(-60px) rotate(3deg);
            }
        }
        
        @keyframes butterfly-flight {
            0%, 100% {
                transform: translate(0, 0) rotate(0deg);
            }
            25% {
                transform: translate(100px, -100px) rotate(15deg);
            }
            50% {
                transform: translate(200px, -50px) rotate(-15deg);
            }
            75% {
                transform: translate(100px, -150px) rotate(10deg);
            }
        }
        
        @keyframes bird-flight {
            0% {
                left: -100px;
                transform: translateY(0);
            }
            50% {
                transform: translateY(-30px);
            }
            100% {
                left: calc(100% + 100px);
                transform: translateY(0);
            }
        }
        
        @keyframes particle-float {
            0% {
                opacity: 0;
                transform: translateY(100vh) scale(0);
            }
            50% {
                opacity: 1;
            }
            100% {
                opacity: 0;
                transform: translateY(-100vh) scale(1);
            }
        }
        
        /* Responsive */
        @media (max-width: 1024px) {
            .gallery-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            
            .hero-title {
                font-size: 60px;
            }
        }
        
        @media (max-width: 768px) {
            nav {
                padding: 20px 30px;
            }
            
            .logo {
                font-size: 24px;
            }
            
            .nav-links {
                display: none;
            }
            
            .hero-title {
                font-size: 40px;
            }
            
            .hero-subtitle {
                font-size: 18px;
            }
            
            .gallery-grid {
                grid-template-columns: 1fr;
                gap: 30px;
            }
            
            .section-title {
                font-size: 40px;
            }
            
            .flower {
                width: 80px;
                height: 80px;
            }
        }
    </style>
</head>
<body>
    <!-- Custom Cursor -->
    <div class="cursor"></div>
    <div class="cursor-follower"></div>
    
    <!-- Navigation -->
    <nav>
        <div class="logo">Enchanted Garden</div>
        <ul class="nav-links">
            <li><a href="#home">Home</a></li>
            <li><a href="#gallery">Gallery</a></li>
            <li><a href="#collection">Collection</a></li>
            <li><a href="#contact">Contact</a></li>
        </ul>
    </nav>
    
    <!-- Hero Section -->
    <section class="hero" id="home">
        <!-- Particles -->
        <div class="particles" id="particles"></div>
        
        <!-- Floating Flowers -->
        <div class="flower flower1" style="background-image: url('https://images.unsplash.com/photo-1490750967868-88aa4486c946?w=400&h=400&fit=crop');"></div>
        <div class="flower flower2" style="background-image: url('https://images.unsplash.com/photo-1463797221720-6b07e6426c24?w=400&h=400&fit=crop');"></div>
        <div class="flower flower3" style="background-image: url('https://images.unsplash.com/photo-1508610048659-a06b669e3321?w=400&h=400&fit=crop');"></div>
        <div class="flower flower4" style="background-image: url('https://images.unsplash.com/photo-1518709268805-4e9042af9f23?w=400&h=400&fit=crop');"></div>
        
        <!-- Butterflies -->
        <div class="butterfly butterfly1" style="background-image: url('https://images.unsplash.com/photo-1526336024174-e58f5cdd8e13?w=200&h=200&fit=crop');"></div>
        <div class="butterfly butterfly2" style="background-image: url('https://images.unsplash.com/photo-1524232356174-61b48c0c8f3d?w=200&h=200&fit=crop');"></div>
        <div class="butterfly butterfly3" style="background-image: url('https://images.unsplash.com/photo-1593721244601-37c5e0661f2f?w=200&h=200&fit=crop');"></div>
        
        <!-- Birds -->
        <div class="bird bird1" style="background-image: url('https://images.unsplash.com/photo-1552728089-57bdde30beb3?w=150&h=150&fit=crop');"></div>
        <div class="bird bird2" style="background-image: url('https://images.unsplash.com/photo-1444464666168-49d633b86797?w=150&h=150&fit=crop');"></div>
        
        <div class="hero-content">
            <h1 class="hero-title">Welcome to Paradise</h1>
            <p class="hero-subtitle">Where Nature Meets Fantasy</p>
            <button class="cta-button">Explore the Garden</button>
        </div>
    </section>
    
    <!-- Gallery Section -->
    <section class="gallery-section" id="gallery">
        <h2 class="section-title">Flower Gallery</h2>
        <div class="gallery-grid">
            <div class="gallery-item">
                <img src="https://images.unsplash.com/photo-1490750967868-88aa4486c946?w=800&h=800&fit=crop" alt="Rose">
                <div class="gallery-overlay">
                    <h3 class="gallery-title">Mystical Rose</h3>
                    <p class="gallery-description">Symbol of eternal love and beauty</p>
                </div>
            </div>
            <div class="gallery-item">
                <img src="https://images.unsplash.com/photo-1463797221720-6b07e6426c24?w=800&h=800&fit=crop" alt="Tulip">
                <div class="gallery-overlay">
                    <h3 class="gallery-title">Dancing Tulips</h3>
                    <p class="gallery-description">Grace in every petal</p>
                </div>
            </div>
            <div class="gallery-item">
                <img src="https://images.unsplash.com/photo-1508610048659-a06b669e3321?w=800&h=800&fit=crop" alt="Sunflower">
                <div class="gallery-overlay">
                    <h3 class="gallery-title">Golden Sunflower</h3>
                    <p class="gallery-description">Radiance of pure joy</p>
                </div>
            </div>
            <div class="gallery-item">
                <img src="https://images.unsplash.com/photo-1518709268805-4e9042af9f23?w=800&h=800&fit=crop" alt="Cherry Blossom">
                <div class="gallery-overlay">
                    <h3 class="gallery-title">Cherry Blossom</h3>
                    <p class="gallery-description">Fleeting beauty of spring</p>
                </div>
            </div>
            <div class="gallery-item">
                <img src="https://images.unsplash.com/photo-1470058869958-2a77ade41c02?w=800&h=800&fit=crop" alt="Orchid">
                <div class="gallery-overlay">
                    <h3 class="gallery-title">Elegant Orchid</h3>
                    <p class="gallery-description">Exotic sophistication</p>
                </div>
            </div>
            <div class="gallery-item">
                <img src="https://images.unsplash.com/photo-1487070183336-b863922373d4?w=800&h=800&fit=crop" alt="Lavender">
                <div class="gallery-overlay">
                    <h3 class="gallery-title">Lavender Dreams</h3>
                    <p class="gallery-description">Serenity in purple waves</p>
                </div>
            </div>
        </div>
    </section>
    
    <!-- Cards Section -->
    <section class="cards-section" id="collection">
        <h2 class="section-title">Our Collection</h2>
        <div class="cards-grid">
            <div class="flower-card">
                <div class="flower-card-image">
                    <img src="https://images.unsplash.com/photo-1496062031456-07b8f162a322?w=500&h=500&fit=crop" alt="Peony">
                </div>
                <h3>Divine Peony</h3>
                <p>Abundance and prosperity bloom in layers of delicate petals</p>
            </div>
            <div class="flower-card">
                <div class="flower-card-image">
                    <img src="https://images.unsplash.com/photo-1462275646964-a0e3386b89fa?w=500&h=500&fit=crop" alt="Lotus">
                </div>
                <h3>Sacred Lotus</h3>
                <p>Rising from the depths to enlightenment and purity</p>
            </div>
            <div class="flower-card">
                <div class="flower-card-image">
                    <img src="https://images.unsplash.com/photo-1582794543139-8ac9cb0f7b11?w=500&h=500&fit=crop" alt="Dahlia">
                </div>
                <h3>Majestic Dahlia</h3>
                <p>Bold elegance in geometric perfection</p>
            </div>
        </div>
    </section>
    
    <!-- Footer -->
    <footer id="contact">
        <p>© 2026 Enchanted Garden. Where Dreams Blossom Into Reality.</p>
    </footer>
    
    <script>
        // Custom Cursor
        const cursor = document.querySelector('.cursor');
        const cursorFollower = document.querySelector('.cursor-follower');
        
        let mouseX = 0, mouseY = 0;
        let followerX = 0, followerY = 0;
        
        document.addEventListener('mousemove', (e) => {
            mouseX = e.clientX;
            mouseY = e.clientY;
            
            cursor.style.left = mouseX + 'px';
            cursor.style.top = mouseY + 'px';
        });
        
        function animateFollower() {
            followerX += (mouseX - followerX) * 0.1;
            followerY += (mouseY - followerY) * 0.1;
            
            cursorFollower.style.left = followerX + 'px';
            cursorFollower.style.top = followerY + 'px';
            
            requestAnimationFrame(animateFollower);
        }
        animateFollower();
        
        // Cursor hover effect
        const hoverElements = document.querySelectorAll('a, button, .gallery-item, .flower-card');
        hoverElements.forEach(element => {
            element.addEventListener('mouseenter', () => {
                cursor.style.transform = 'scale(2)';
                cursorFollower.style.transform = 'scale(1.5)';
            });
            element.addEventListener('mouseleave', () => {
                cursor.style.transform = 'scale(1)';
                cursorFollower.style.transform = 'scale(1)';
            });
        });
        
        // Generate particles
        const particlesContainer = document.getElementById('particles');
        for (let i = 0; i < 30; i++) {
            const particle = document.createElement('div');
            particle.classList.add('particle');
            particle.style.left = Math.random() * 100 + '%';
            particle.style.width = Math.random() * 10 + 5 + 'px';
            particle.style.height = particle.style.width;
            particle.style.animationDelay = Math.random() * 15 + 's';
            particle.style.animationDuration = Math.random() * 10 + 10 + 's';
            particlesContainer.appendChild(particle);
        }
        
        // Parallax Effect
        window.addEventListener('scroll', () => {
            const scrolled = window.pageYOffset;
            
            // Parallax for flowers
            const flowers = document.querySelectorAll('.flower');
            flowers.forEach((flower, index) => {
                const speed = (index % 2 === 0) ? 0.5 : -0.5;
                flower.style.transform = `translateY(${scrolled * speed}px)`;
            });
            
            // Parallax for butterflies
            const butterflies = document.querySelectorAll('.butterfly');
            butterflies.forEach((butterfly, index) => {
                const speed = 0.3 + (index * 0.1);
                butterfly.style.transform = `translateY(${scrolled * speed}px)`;
            });
        });
        
        // 3D tilt effect for gallery items
        const galleryItems = document.querySelectorAll('.gallery-item');
        galleryItems.forEach(item => {
            item.addEventListener('mousemove', (e) => {
                const rect = item.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                
                const centerX = rect.width / 2;
                const centerY = rect.height / 2;
                
                const rotateX = (y - centerY) / 10;
                const rotateY = (centerX - x) / 10;
                
                item.style.transform = `scale(1.05) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
            });
            
            item.addEventListener('mouseleave', () => {
                item.style.transform = 'scale(1) rotateX(0) rotateY(0)';
            });
        });
        
        // Smooth scroll
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });
        
        // Intersection Observer for animations
        const observerOptions = {
            threshold: 0.2,
            rootMargin: '0px 0px -100px 0px'
        };
        
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.opacity = '1';
                    entry.target.style.transform = 'translateY(0)';
                }
            });
        }, observerOptions);
        
        // Observe gallery items
        document.querySelectorAll('.gallery-item, .flower-card').forEach(item => {
            item.style.opacity = '0';
            item.style.transform = 'translateY(50px)';
            item.style.transition = 'all 0.8s ease';
            observer.observe(item);
