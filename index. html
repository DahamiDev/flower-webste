<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Anime Blossom Garden | 3D Cartoon Paradise</title>
    <!-- Google Fonts for Anime/Manga style -->
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300;400;500;600;700&family=Poppins:wght@400;600;800&display=swap" rel="stylesheet">
    <!-- Three.js Core -->
    <script type="importmap">
        {
            "imports": {
                "three": "https://unpkg.com/three@0.128.0/build/three.module.js"
            }
        }
    </script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Quicksand', 'Poppins', sans-serif;
            background: radial-gradient(circle at 20% 30%, #0a0f1e, #03050b);
            color: #fff9f0;
            overflow-x: hidden;
            cursor: none;
        }

        /* Custom Anime Sparkle Cursor */
        .cursor-star {
            width: 24px;
            height: 24px;
            background: radial-gradient(circle, #ffdd99, #ffaa66);
            border-radius: 50%;
            position: fixed;
            pointer-events: none;
            z-index: 10000;
            mix-blend-mode: screen;
            filter: blur(1px);
            box-shadow: 0 0 15px #ffb347;
            transition: transform 0.05s linear;
        }
        
        .cursor-trail {
            width: 12px;
            height: 12px;
            background: #ffe6b3;
            border-radius: 50%;
            position: fixed;
            pointer-events: none;
            z-index: 9999;
            opacity: 0.6;
            filter: blur(3px);
        }

        /* Anime Navigation */
        nav {
            position: fixed;
            top: 0;
            width: 100%;
            padding: 20px 50px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 100;
            background: linear-gradient(180deg, rgba(10,15,30,0.85) 0%, transparent 100%);
            backdrop-filter: blur(5px);
        }

        .logo {
            font-size: 28px;
            font-weight: 800;
            background: linear-gradient(135deg, #FFD966, #FFB56B, #FF8C94);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            letter-spacing: 2px;
            text-shadow: 0 0 20px rgba(255,180,100,0.6);
            font-family: 'Poppins', sans-serif;
        }

        .nav-links {
            display: flex;
            gap: 35px;
            list-style: none;
        }

        .nav-links a {
            color: #ffefd6;
            text-decoration: none;
            font-weight: 600;
            font-size: 18px;
            transition: 0.3s;
            position: relative;
        }

        .nav-links a::after {
            content: '🌸';
            position: absolute;
            bottom: -20px;
            left: 50%;
            transform: translateX(-50%) scale(0);
            opacity: 0;
            transition: 0.3s;
            font-size: 14px;
        }

        .nav-links a:hover::after {
            opacity: 1;
            transform: translateX(-50%) scale(1);
        }

        /* Hero Section with Anime Vibe */
        .hero {
            height: 100vh;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            overflow: hidden;
        }

        .hero-content {
            z-index: 20;
            animation: floatText 2s ease-out;
        }

        .hero-title {
            font-size: 85px;
            font-weight: 800;
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #FFE6B0, #FFB347, #FF8C69);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            text-shadow: 0 0 30px rgba(255,140,100,0.7);
            letter-spacing: 4px;
        }

        .hero-subtitle {
            font-size: 28px;
            margin: 20px 0;
            font-weight: 500;
            color: #ffe0b5;
            background: rgba(0,0,0,0.4);
            display: inline-block;
            padding: 8px 24px;
            border-radius: 60px;
            backdrop-filter: blur(8px);
        }

        .cta-button {
            padding: 14px 42px;
            background: linear-gradient(45deg, #ffaa66, #ff6f91);
            border: none;
            border-radius: 50px;
            font-size: 20px;
            font-weight: bold;
            color: #2d1b0e;
            cursor: none;
            transition: 0.3s;
            box-shadow: 0 10px 25px #ff8c5a;
            font-family: 'Poppins', sans-serif;
        }

        /* 2D Cartoon Floating Elements */
        .anime-floating {
            position: absolute;
            pointer-events: none;
            z-index: 5;
            font-size: 45px;
            filter: drop-shadow(0 8px 12px rgba(0,0,0,0.3));
            animation: floatSoft 12s infinite ease-in-out;
        }

        /* Gallery Section - Cartoon/Anime Style Cards */
        .gallery-section {
            padding: 100px 40px;
            background: rgba(5, 10, 20, 0.7);
            position: relative;
            z-index: 10;
        }

        .section-title {
            text-align: center;
            font-size: 58px;
            font-weight: 800;
            margin-bottom: 60px;
            background: linear-gradient(135deg, #FFE6B0, #FFB85E);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 40px;
            max-width: 1300px;
            margin: 0 auto;
        }

        .anime-card {
            background: rgba(30, 25, 55, 0.65);
            backdrop-filter: blur(12px);
            border-radius: 40px;
            overflow: hidden;
            border: 2px solid rgba(255, 200, 150, 0.6);
            transition: all 0.4s cubic-bezier(0.2, 0.9, 0.4, 1.1);
            box-shadow: 0 20px 35px rgba(0,0,0,0.4);
        }

        .anime-card:hover {
            transform: translateY(-15px) rotate(1deg);
            border-color: #ffbc6e;
            box-shadow: 0 30px 45px rgba(255,140,80,0.3);
        }

        .card-img {
            height: 280px;
            overflow: hidden;
            position: relative;
        }

        .card-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s;
        }

        .anime-card:hover .card-img img {
            transform: scale(1.08);
        }

        .card-content {
            padding: 24px;
            text-align: center;
        }

        .card-content h3 {
            font-size: 28px;
            color: #FFD58C;
            margin-bottom: 12px;
        }

        .card-content p {
            color: #f0e2c5;
            font-weight: 500;
        }

        /* 3D Canvas styling */
        #three-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            pointer-events: none;
        }

        /* Section adjustments */
        .cards-section {
            position: relative;
            z-index: 15;
            padding: 100px 40px;
        }

        .cards-grid-3d {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 50px;
            max-width: 1200px;
            margin: 0 auto;
        }

        .cartoon-flower-card {
            background: linear-gradient(145deg, #2a2438, #191126);
            border-radius: 48px;
            padding: 20px;
            width: 280px;
            text-align: center;
            transition: all 0.3s;
            border: 1px solid #ffc085;
            box-shadow: 0 20px 30px -10px black;
        }

        .cartoon-flower-card:hover {
            transform: scale(1.02) translateY(-12px);
            border-color: #ffaa55;
        }

        .anime-icon {
            font-size: 85px;
            filter: drop-shadow(0 10px 15px #ffa559);
        }

        footer {
            padding: 50px;
            text-align: center;
            font-size: 18px;
            font-weight: 500;
            background: rgba(0,0,0,0.6);
            backdrop-filter: blur(10px);
            border-top: 1px solid #ffc285;
            position: relative;
            z-index: 10;
        }

        @keyframes floatText {
            0% { opacity: 0; transform: translateY(60px); }
            100% { opacity: 1; transform: translateY(0); }
        }

        @keyframes floatSoft {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-35px) rotate(6deg); }
        }

        @media (max-width: 768px) {
            .hero-title { font-size: 48px; }
            .nav-links { display: none; }
            nav { padding: 15px 25px; }
        }
    </style>
</head>
<body>
    <!-- 3D Canvas for Anime Flowers and Particles -->
    <canvas id="three-canvas"></canvas>

    <div class="cursor-star"></div>
    <div class="cursor-trail"></div>

    <nav>
        <div class="logo">✨ Anime Blossom ✨</div>
        <ul class="nav-links">
            <li><a href="#home">Home</a></li>
            <li><a href="#gallery">Gallery</a></li>
            <li><a href="#collection">Kawaii Collection</a></li>
            <li><a href="#contact">Contact</a></li>
        </ul>
    </nav>

    <section class="hero" id="home">
        <!-- Anime floating props -->
        <div class="anime-floating" style="top: 15%; left: 5%; animation-duration: 14s;">🍥🌸</div>
        <div class="anime-floating" style="top: 70%; left: 85%; animation-duration: 18s;">✨🍃</div>
        <div class="anime-floating" style="top: 30%; right: 8%; animation-duration: 11s;">🎴🌼</div>
        <div class="anime-floating" style="bottom: 20%; left: 20%; animation-duration: 16s;">🍂⭐</div>
        
        <div class="hero-content">
            <h1 class="hero-title">Kawaii Flower Realm</h1>
            <p class="hero-subtitle">✦ Where Anime Dreams Bloom in 3D ✦</p>
            <button class="cta-button" id="exploreBtn">🌸 Explore Magic 🌸</button>
        </div>
    </section>

    <!-- Cartoon Gallery with Beautiful Anime-style images -->
    <section class="gallery-section" id="gallery">
        <h2 class="section-title">☆ Enchanted Flower Gallery ☆</h2>
        <div class="gallery-grid">
            <div class="anime-card">
                <div class="card-img"><img src="https://cdn.pixabay.com/photo/2021/08/25/02/45/rose-6572495_960_720.jpg" alt="Anime Rose"></div>
                <div class="card-content"><h3>❤️ Magical Rose</h3><p>Sparkling petals of eternal love</p></div>
            </div>
            <div class="anime-card">
                <div class="card-img"><img src="https://cdn.pixabay.com/photo/2020/06/28/17/13/sunflower-5351231_960_720.jpg" alt="Sunflower Girl"></div>
                <div class="card-content"><h3>🌻 Happy Sunflower</h3><p>Radiant like summer anime</p></div>
            </div>
            <div class="anime-card">
                <div class="card-img"><img src="https://cdn.pixabay.com/photo/2017/10/17/18/01/cherry-blossom-2861553_960_720.jpg" alt="Sakura Fantasy"></div>
                <div class="card-content"><h3>🌸 Sakura Dream</h3><p>Floating cherry blossoms</p></div>
            </div>
            <div class="anime-card">
                <div class="card-img"><img src="https://cdn.pixabay.com/photo/2019/03/19/22/26/lavender-4067266_960_720.jpg" alt="Lavender Magic"></div>
                <div class="card-content"><h3>💜 Lavender Breeze</h3><p>Calm & whimsical fields</p></div>
            </div>
            <div class="anime-card">
                <div class="card-img"><img src="https://cdn.pixabay.com/photo/2016/03/19/15/51/lotus-1267368_960_720.jpg" alt="Lotus Goddess"></div>
                <div class="card-content"><h3>🪷 Divine Lotus</h3><p>Purity & ethereal glow</p></div>
            </div>
            <div class="anime-card">
                <div class="card-img"><img src="https://cdn.pixabay.com/photo/2022/04/20/18/26/hydrangea-7145197_960_720.jpg" alt="Hydrangea Anime"></div>
                <div class="card-content"><h3>💙 Hydrangea Rhapsody</h3><p>Pastel color splash</p></div>
            </div>
        </div>
    </section>

    <!-- 3D Cartoon Flower Collection -->
    <section class="cards-section" id="collection">
        <h2 class="section-title">✦ Kawaii 3D Flower Spirits ✦</h2>
        <div class="cards-grid-3d">
            <div class="cartoon-flower-card">
                <div class="anime-icon">🌸✨</div>
                <h3 style="color:#FFB347">Chibi Sakura</h3>
                <p>Whimsical floating petals with starry sparkle aura.</p>
            </div>
            <div class="cartoon-flower-card">
                <div class="anime-icon">🌼⭐</div>
                <h3 style="color:#FFD966">Sunny Dandelion</h3>
                <p>Soft yellow magic that brings smiles.</p>
            </div>
            <div class="cartoon-flower-card">
                <div class="anime-icon">🌺🎀</div>
                <h3 style="color:#FF8C94">Hibiscus Cutie</h3>
                <p>Tropical anime charm with pastel gradients.</p>
            </div>
        </div>
    </section>

    <footer id="contact">
        <p>🍃 © 2026 Enchanted Anime Garden — Where Flowers Have Souls & Magic is Real 🍃</p>
    </footer>

    <script type="module">
        import * as THREE from 'three';

        // Setup Scene, Camera, Renderer
        const canvas = document.getElementById('three-canvas');
        const scene = new THREE.Scene();
        scene.background = null; // transparent so gradient shows
        scene.fog = new THREE.FogExp2(0x03050b, 0.008);
        
        const camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 1000);
        camera.position.set(0, 4, 18);
        camera.lookAt(0, 2, 0);
        
        const renderer = new THREE.WebGLRenderer({ canvas, alpha: true });
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.setPixelRatio(window.devicePixelRatio);
        
        // Lights
        const ambientLight = new THREE.AmbientLight(0x443366);
        scene.add(ambientLight);
        const mainLight = new THREE.DirectionalLight(0xffccaa, 1.2);
        mainLight.position.set(5, 12, 6);
        scene.add(mainLight);
        const fillLight = new THREE.PointLight(0xffaa88, 0.6);
        fillLight.position.set(-3, 5, 4);
        scene.add(fillLight);
        const backLight = new THREE.PointLight(0x88aaff, 0.5);
        backLight.position.set(0, 5, -8);
        scene.add(backLight);
        
        // Anime style floating 3D flowers (cartoon look)
        function createCartoonFlower(x, z, color, petalColor2, size = 0.6) {
            const group = new THREE.Group();
            
            // Stem (cylinder)
            const stemMat = new THREE.MeshStandardMaterial({ color: 0x7cb518, roughness: 0.4, emissive: 0x226622, emissiveIntensity: 0.2 });
            const stem = new THREE.Mesh(new THREE.CylinderGeometry(0.12, 0.16, 1.2, 6), stemMat);
            stem.position.y = -0.5;
            group.add(stem);
            
            // Leaves
            const leafMat = new THREE.MeshStandardMaterial({ color: 0x6aab35, emissive: 0x33aa33, emissiveIntensity: 0.2 });
            const leafGeo = new THREE.SphereGeometry(0.22, 6, 6);
            const leaf1 = new THREE.Mesh(leafGeo, leafMat);
            leaf1.position.set(0.3, -0.2, 0);
            leaf1.scale.set(0.9, 0.3, 0.5);
            group.add(leaf1);
            const leaf2 = leaf1.clone();
            leaf2.position.set(-0.3, -0.2, 0);
            group.add(leaf2);
            
            // Center pistil (glowing)
            const pistilMat = new THREE.MeshStandardMaterial({ color: 0xffaa66, emissive: 0xff6633, emissiveIntensity: 0.5 });
            const pistil = new THREE.Mesh(new THREE.SphereGeometry(0.22, 16, 16), pistilMat);
            pistil.position.y = 0.25;
            group.add(pistil);
            
            // Petals (rounded cubes for cartoon feel)
            const petalMat = new THREE.MeshStandardMaterial({ color: color, emissive: color, emissiveIntensity: 0.25 });
            const petalMat2 = new THREE.MeshStandardMaterial({ color: petalColor2, emissive: petalColor2, emissiveIntensity: 0.2 });
            const petalGeo = new THREE.SphereGeometry(0.4, 12, 12);
            for (let i = 0; i < 8; i++) {
                const angle = (i / 8) * Math.PI * 2;
                const radius = 0.7;
                const petal = new THREE.Mesh(petalGeo, i % 2 === 0 ? petalMat : petalMat2);
                petal.position.x = Math.cos(angle) * radius;
                petal.position.z = Math.sin(angle) * radius;
                petal.position.y = 0.15;
                petal.scale.set(0.9, 0.55, 0.9);
                group.add(petal);
            }
            // inner petals
            const innerMat = new THREE.MeshStandardMaterial({ color: 0xffdd99, emissive: 0xffaa77 });
            for (let i = 0; i < 5; i++) {
                const angle = (i / 5) * Math.PI * 2;
                const innerPetal = new THREE.Mesh(new THREE.SphereGeometry(0.28, 10), innerMat);
                innerPetal.position.x = Math.cos(angle) * 0.45;
                innerPetal.position.z = Math.sin(angle) * 0.45;
                innerPetal.position.y = 0.28;
                innerPetal.scale.set(0.8, 0.5, 0.8);
                group.add(innerPetal);
            }
            
            group.position.set(x, -1.2 + Math.random() * 0.5, z);
            return group;
        }
        
        // Floating Anime Flower Spirits
        const flowerColors = [
            { main: 0xff7799, second: 0xffb3c6 }, // sakura pink
            { main: 0xffaa66, second: 0xffdd99 }, // orange
            { main: 0x99ccff, second: 0xcce6ff }, // pastel blue
            { main: 0xddaaff, second: 0xf0ccff }, // lavender
            { main: 0x88dd88, second: 0xb8f2b8 }  // mint
        ];
        
        const flowers3D = [];
        const positions = [
            [-3.2, -1.2, -3], [3.5, -1.2, -2.5], [-2, -1, -4.5], [1.8, -1.1, -4], [0, -1.3, -5.2],
            [-4, -1, 0], [4.2, -1, 0.5], [-1.5, -0.8, 1.8], [2.5, -1, 2.2], [0, -0.9, 3],
            [-3.8, -1, 2.8], [3.9, -1.2, 3.2], [-2.8, -0.7, -1], [2.9, -0.9, -1.4]
        ];
        
        positions.forEach(pos => {
            const rand = flowerColors[Math.floor(Math.random() * flowerColors.length)];
            const flower = createCartoonFlower(pos[0], pos[2], rand.main, rand.second, 0.55);
            scene.add(flower);
            flowers3D.push(flower);
        });
        
        // Add floating magical orbs / sparkles (anime particles)
        const particleCount = 350;
        const particleGeometry = new THREE.BufferGeometry();
        const particlePositions = new Float32Array(particleCount * 3);
        for (let i = 0; i < particleCount; i++) {
            particlePositions[i*3] = (Math.random() - 0.5) * 22;
            particlePositions[i*3+1] = Math.random() * 8;
            particlePositions[i*3+2] = (Math.random() - 0.5) * 15 - 5;
        }
        particleGeometry.setAttribute('position', new THREE.BufferAttribute(particlePositions, 3));
        const particleMaterial = new THREE.PointsMaterial({
            color: 0xffaa88,
            size: 0.08,
            transparent: true,
            opacity: 0.7,
            blending: THREE.AdditiveBlending
        });
        const particles = new THREE.Points(particleGeometry, particleMaterial);
        scene.add(particles);
        
        // Add cute tiny floating hearts (using custom geometry)
        const heartGroup = new THREE.Group();
        const heartMat = new THREE.MeshStandardMaterial({ color: 0xff5e7e, emissive: 0xff3366, emissiveIntensity: 0.4 });
        for (let i = 0; i < 60; i++) {
            const heartGeo = new THREE.SphereGeometry(0.09, 8);
            const heart = new THREE.Mesh(heartGeo, heartMat);
            heart.position.x = (Math.random() - 0.5) * 14;
            heart.position.y = Math.random() * 6;
            heart.position.z = (Math.random() - 0.5) * 12 - 4;
            heart.scale.set(1, 1.2, 0.6);
            heartGroup.add(heart);
        }
        scene.add(heartGroup);
        
        // Glowing floating ribbons effect (small toruses)
        const ribbonGroup = new THREE.Group();
        const ribbonMat = new THREE.MeshStandardMaterial({ color: 0xffb374, emissive: 0xff8844 });
        for (let i = 0; i < 40; i++) {
            const torus = new THREE.Mesh(new THREE.TorusGeometry(0.12, 0.03, 12, 24), ribbonMat);
            torus.position.set((Math.random() - 0.5) * 12, Math.random() * 7, (Math.random() - 0.5) * 12);
            torus.rotation.x = Math.random() * Math.PI;
            torus.rotation.z = Math.random() * Math.PI;
            ribbonGroup.add(torus);
        }
        scene.add(ribbonGroup);
        
        // Add rotating glowing stars (anime sparkle)
        const starGroup = new THREE.Group();
        const starMat = new THREE.MeshStandardMaterial({ color: 0xffdd99, emissive: 0xffaa55 });
        for (let i = 0; i < 80; i++) {
            const starShape = new THREE.SphereGeometry(0.06, 6);
            const starMesh = new THREE.Mesh(starShape, starMat);
            starMesh.position.set((Math.random() - 0.5) * 18, Math.random() * 6, (Math.random() - 0.5) * 14);
            starGroup.add(starMesh);
        }
        scene.add(starGroup);
        
        // anime butterfly-like floating geometry
        const butterflies = [];
        const butterflyMat = new THREE.MeshStandardMaterial({ color: 0xffaa99, emissive: 0xff8866 });
        for (let i = 0; i < 12; i++) {
            const wingL = new THREE.Mesh(new THREE.ConeGeometry(0.2, 0.4, 6), butterflyMat);
            const wingR = new THREE.Mesh(new THREE.ConeGeometry(0.2, 0.4, 6), butterflyMat);
            wingL.rotation.z = 0.7;
            wingR.rotation.z = -0.7;
            wingL.position.set(-0.25, 0, 0);
            wingR.position.set(0.25, 0, 0);
            const body = new THREE.Mesh(new THREE.SphereGeometry(0.1, 6), new THREE.MeshStandardMaterial({ color: 0xdd8855 }));
            const butterfly = new THREE.Group();
            butterfly.add(wingL, wingR, body);
            butterfly.position.set((Math.random() - 0.5) * 12, Math.random() * 5 + 1, (Math.random() - 0.5) * 12);
            scene.add(butterfly);
            butterflies.push({ obj: butterfly, speedX: (Math.random() - 0.5) * 0.008, speedY: (Math.random() - 0.5) * 0.006, speedZ: (Math.random() - 0.5) * 0.008, rotSpeed: Math.random() * 0.02 });
        }
        
        // Animation loop: float flowers & particles
        let time = 0;
        function animate() {
            requestAnimationFrame(animate);
            time += 0.012;
            
            // float flowers gently
            flowers3D.forEach((flower, idx) => {
                flower.position.y += Math.sin(time * 1.2 + idx) * 0.003;
                flower.rotation.y = Math.sin(time * 0.7 + idx) * 0.2;
                flower.rotation.x = Math.sin(time * 0.5) * 0.05;
            });
            
            // Rotate particles and stars
            particles.rotation.y = time * 0.05;
            heartGroup.rotation.y = time * 0.1;
            ribbonGroup.rotation.x = Math.sin(time * 0.3) * 0.2;
            starGroup.rotation.z = time * 0.08;
            
            butterflies.forEach(butter => {
                butter.obj.position.x += butter.speedX;
                butter.obj.position.y += butter.speedY;
                butter.obj.position.z += butter.speedZ;
                butter.obj.rotation.z = Math.sin(time * 3) * 0.5;
                if (Math.abs(butter.obj.position.x) > 9) butter.speedX *= -1;
                if (butter.obj.position.y > 6 || butter.obj.position.y < 1) butter.speedY *= -1;
                if (Math.abs(butter.obj.position.z) > 8) butter.speedZ *= -1;
            });
            
            // Camera slight oscillation for dreamy effect
            camera.position.x += (0 - camera.position.x) * 0.02;
            camera.lookAt(0, 1.5, 0);
            
            renderer.render(scene, camera);
        }
        
        animate();
        
        // Handle window resize
        window.addEventListener('resize', onWindowResize, false);
        function onWindowResize() {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        }
    </script>
    
    <script>
        // Custom cursor + anime hover effect
        const starCursor = document.querySelector('.cursor-star');
        const trailCursor = document.querySelector('.cursor-trail');
        let mouseX = 0, mouseY = 0;
        let trailX = 0, trailY = 0;
        
        document.addEventListener('mousemove', (e) => {
            mouseX = e.clientX;
            mouseY = e.clientY;
            starCursor.style.left = mouseX - 12 + 'px';
            starCursor.style.top = mouseY - 12 + 'px';
        });
        
        function animateTrail() {
            trailX += (mouseX - trailX) * 0.2;
            trailY += (mouseY - trailY) * 0.2;
            trailCursor.style.left = trailX - 6 + 'px';
            trailCursor.style.top = trailY - 6 + 'px';
            requestAnimationFrame(animateTrail);
        }
        animateTrail();
        
        // Hover scale effect for buttons and cards
        const allHover = document.querySelectorAll('a, button, .anime-card, .cartoon-flower-card');
        allHover.forEach(el => {
            el.addEventListener('mouseenter', () => { starCursor.style.transform = 'scale(1.5)'; starCursor.style.filter = 'brightness(1.4)'; });
            el.addEventListener('mouseleave', () => { starCursor.style.transform = 'scale(1)'; starCursor.style.filter = 'brightness(1)'; });
        });
        
        // Smooth scroll
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function(e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if(target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            });
        });
        
        // Button magic
        document.getElementById('exploreBtn')?.addEventListener('click', () => {
            document.getElementById('gallery')?.scrollIntoView({ behavior: 'smooth' });
        });
        
        // Intersection Observer fade-up for cards
        const fadeItems = document.querySelectorAll('.anime-card, .cartoon-flower-card');
        const obs = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if(entry.isIntersecting) {
                    entry.target.style.opacity = '1';
                    entry.target.style.transform = 'translateY(0px)';
                }
            });
        }, { threshold: 0.2 });
        fadeItems.forEach(item => {
            item.style.opacity = '0';
            item.style.transform = 'translateY(30px)';
            item.style.transition = 'all 0.6s ease';
            obs.observe(item);
        });
    </script>
</body>
</html>
